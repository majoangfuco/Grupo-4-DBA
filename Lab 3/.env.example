# Variables de docker compose (Lab 3).
# Copiar a ".env" en esta misma carpeta si se quieren cambiar los valores.
# Si el archivo .env no existe, docker compose usa los defaults declarados
# en docker-compose.yml y el stack levanta igual.

# ─── MongoDB · Replica Set ───────────────────────────────────────
MONGO_REPLICA_SET=rs0
MONGO_DB=b2b

# Usuario administrador del cluster (solo lo usa mongo-init)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpass

# Usuario que consume el backend (readWrite sobre b2b + clusterMonitor)
MONGO_APP_USER=b2b_app
MONGO_APP_PASSWORD=b2b_app_pass

# Carritos ABANDONADOS: 30 dias desde ultimaActividad (en segundos)
MONGO_CART_TTL_SECONDS=2592000
